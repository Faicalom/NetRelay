<Window x:Class="NetRelay.UI.ChromiumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Net Relay for Windows"
        Width="1380" Height="860" MinWidth="320" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="#050C16"
        Icon="/assets/NetRelay.ico"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#050C16" />
        <Border x:Name="LoadingPanel" Background="#050C16">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/assets/NetRelay.png" Width="74" Height="74" Stretch="Uniform" />
                <TextBlock Text="Net Relay" Foreground="#F0FAFF" FontSize="25" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,18,0,5" />
                <TextBlock Text="Loading local interface…" Foreground="#88A8BA" FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
